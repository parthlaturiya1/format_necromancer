{
    "version":  "v1",
    "hooks":  [
                  {
                      "name":  "provenance-prompt-submit",
                      "description":  "Append a ledger line on UserPromptSubmit (scripts/provenance/record.mjs). Payload arrives on stdin.",
                      "trigger":  "UserPromptSubmit",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event UserPromptSubmit --summary UserPromptSubmit"
                                 },
                      "timeout":  10
                  },
                  {
                      "name":  "provenance-post-tool-use",
                      "description":  "Append a ledger line on PostToolUse (scripts/provenance/record.mjs). Payload arrives on stdin.",
                      "trigger":  "PostToolUse",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event PostToolUse --summary PostToolUse"
                                 },
                      "timeout":  10
                  },
                  {
                      "name":  "provenance-file-create",
                      "description":  "Append a ledger line on PostFileCreate (scripts/provenance/record.mjs). Payload arrives on stdin.",
                      "trigger":  "PostFileCreate",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event PostFileCreate --summary PostFileCreate --path \"{{filePath}}\""
                                 },
                      "timeout":  10
                  },
                  {
