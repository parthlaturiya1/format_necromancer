                      "trigger":  "PostFileDelete",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event PostFileDelete --summary PostFileDelete --path \"{{filePath}}\""
                                 },
                      "timeout":  10
                  },
                  {
                      "name":  "provenance-agent-stop",
                      "description":  "Append a ledger line on Stop (scripts/provenance/record.mjs). Payload arrives on stdin.",
                      "trigger":  "Stop",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event Stop --summary Stop"
                                 },
                      "timeout":  10
                  },
                  {
                      "name":  "provenance-pre-task",
