                      "trigger":  "PreTaskExec",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event PreTaskExec --summary PreTaskExec"
                                 },
                      "timeout":  10
                  },
                  {
                      "name":  "provenance-post-task",
                      "description":  "Append a ledger line on PostTaskExec (scripts/provenance/record.mjs). Payload arrives on stdin.",
                      "trigger":  "PostTaskExec",
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/provenance/record.mjs --agent kiro --event PostTaskExec --summary PostTaskExec"
                                 },
                      "timeout":  10
                  }
              ]
}
