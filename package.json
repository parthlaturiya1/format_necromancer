{
  "name": "format-necromancer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only app that recovers a dead file format from bytes alone.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "provenance:check": "node scripts/provenance/check.mjs",
    "corpus:validate": "node scripts/corpus/validate.mjs",
    "golden:report": "vitest run tests/engine/golden-report.test.ts",
    "golden:v2": "vitest run tests/engine/golden-v2.test.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
